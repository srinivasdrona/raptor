# These text artifacts were approved and hash-pinned from CRLF bytes.
# Preserve that byte contract on every platform; changing it requires a
# separately approved policy/provenance repin.
configs/acmg/tsc.yaml text eol=crlf
configs/eval/tsc2.yaml text eol=crlf
configs/eval/bias_lineage.yaml text eol=crlf
configs/packet/candidate_direction.yaml text eol=crlf
configs/eval/predictor_aggregation.yaml text eol=crlf
configs/eval/predictor_training_manifests.yaml text eol=crlf
configs/eval/pp3bp4_source_register.yaml text eol=crlf
configs/eval/pp3bp4_candidate_policy.json text eol=crlf
src/raptor/eval/predictor_aggregation.py text eol=crlf
src/raptor/eval/predictor_policy.py text eol=crlf
src/raptor/eval/terminal_source.py text eol=crlf
scripts/run_masked_holdout_eval.py text eol=crlf

# RescueScreen literature bundles carry byte-level SHA-256 manifests.
data/rescuescreen/r611q/literature-v1/* text eol=lf
data/rescuescreen/r611q/synthesis-v1/* text eol=lf

# RescueScreen evidence-readiness summary is approved and hash-pinned from CRLF bytes.
data/rescuescreen/r611q/RESCUESCREEN_EVIDENCE_READINESS_SUMMARY.md text eol=crlf

# RescueScreen structure-readiness pack: force LF for every tracked text
# artifact regardless of core.autocrlf, then restore the gzip artifacts to
# binary so they are never subject to text/eol conversion.
data/rescuescreen/r611q/structure-readiness-v1/** text eol=lf
data/rescuescreen/r611q/structure-readiness-v1/**/*.gz -text

# RescueScreen package-v2 summaries are byte-hash pinned by AC11.
data/rescuescreen/r611q/package-v2-addendum/* text eol=lf

# Public Atlas gate result is byte-hash pinned from approved CRLF bytes.
data/atlas/runs/2026-08-03/r611q_gate_result.json text eol=crlf
